# Conexão do Neon (painel do Neon > Connect > copie a "connection string" com -pooler)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Senha que a equipe usa para entrar no sistema
APP_PASSWORD=troque-esta-senha

# Opcional: texto aleatório longo para assinar o login. Se mudar, todos precisam entrar de novo.
SESSION_SECRET=

# Maquininha Mercado Pago (opcional). Sem o token, os botões da maquininha ficam escondidos.
# Access Token de produção (painel do Mercado Pago > Suas integrações > Credenciais)
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
# Número ou id da maquininha Point (ex.: 1734178471 ou NEWLAND_N950__N950NCB801234567)
MERCADOPAGO_POINT_TERMINAL=

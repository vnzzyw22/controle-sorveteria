# Conexão do Neon (painel do Neon > Connect > copie a "connection string" com -pooler)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Senha que a equipe usa para entrar no sistema
APP_PASSWORD=troque-esta-senha

# Opcional: texto aleatório longo para assinar o login. Se mudar, todos precisam entrar de novo.
SESSION_SECRET=
